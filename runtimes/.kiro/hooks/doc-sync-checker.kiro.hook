{
  "enabled": true,
  "name": "Documentation Sync Checker",
  "description": "Checks documentation edits for spec-link drift and unresolved example placeholders.",
  "version": "1",
  "when": {
    "type": "fileSaved",
    "patterns": [
      "README.md",
      "AGENTS.md",
      "docs/**/*.md",
      "examples/**/*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the saved documentation for broken local links, vendor-matrix drift, and TODO markers in examples. Report findings only; do not edit files unless explicitly asked."
  }
}
