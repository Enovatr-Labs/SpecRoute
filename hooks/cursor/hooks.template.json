{
  "_comment": "Executable Cursor starter. The full event catalog is documented in hooks/README.md; active entries reference only shipped scripts.",
  "_reference": "https://cursor.com/docs/agent/hooks",
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash .cursor/hooks/scripts/session-start-status.sh",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash .cursor/hooks/scripts/pre-shell-sanitize.sh",
        "failClosed": true,
        "timeout": 30
      }
    ],
    "afterFileEdit": [
      {
        "command": "bash .cursor/hooks/scripts/post-edit-frontmatter.sh"
      }
    ]
  }
}
