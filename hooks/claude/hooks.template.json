{
  "_comment": "Executable Claude Code starter. Merge this hooks object into .claude/settings.json. The full event taxonomy belongs in hooks/README.md; active entries here reference only shipped scripts.",
  "_reference": "https://code.claude.com/docs/en/hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/session-start-status.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/pre-bash-sanitize.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/post-edit-frontmatter.sh"
          }
        ]
      }
    ]
  }
}
