{
  "_comment": "Claude Code hooks template covering the full ~27-event taxonomy. Drop into .claude/settings.json under the 'hooks' key (project-level) or ~/.claude/settings.json (user-level). Reference: https://code.claude.com/docs/en/hooks",

  "_schema_summary": {
    "matcher": "exact string ('Bash'), |-separated list ('Edit|Write'), or JavaScript regex ('mcp__memory__.*'). Empty / '*' / omitted = match all.",
    "type": "command | http | mcp_tool | prompt | agent",
    "exit_code_protocol": {
      "0": "success; stdout parsed as optional JSON output",
      "2": "blocking error; stderr fed to Claude",
      "other": "non-blocking warning"
    },
    "blocking_json": "exit 0 with hookSpecificOutput.permissionDecision='deny' (PreToolUse) or top-level decision='block' (most other events)"
  },

  "hooks": {
    "Setup": [
      {
        "matcher": "init|maintenance",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/setup.sh"
          }
        ]
      }
    ],

    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/session-start-status.sh"
          }
        ]
      }
    ],

    "InstructionsLoaded": [
      {
        "matcher": "session_start",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/instructions-loaded-banner.sh"
          }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/prompt-policy-check.sh"
          }
        ]
      }
    ],

    "UserPromptExpansion": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/expansion-audit.sh"
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/pre-bash-sanitize.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/pre-edit-validate.sh"
          }
        ]
      },
      {
        "_example_mcp_match": {
          "matcher": "mcp__filesystem__write.*",
          "hooks": [
            {
              "type": "command",
              "command": "bash .claude/hooks/scripts/pre-mcp-fs-write.sh"
            }
          ]
        }
      }
    ],

    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/permission-request-shell.sh"
          }
        ]
      }
    ],

    "PermissionDenied": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/permission-denied-log.sh"
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/post-edit-frontmatter.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/post-bash-log.sh"
          }
        ]
      }
    ],

    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/post-tool-failure-log.sh"
          }
        ]
      }
    ],

    "PostToolBatch": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/post-batch-summary.sh"
          }
        ]
      }
    ],

    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/notification-relay.sh"
          }
        ]
      }
    ],

    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/subagent-start-log.sh"
          }
        ]
      }
    ],

    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/subagent-stop-summary.sh"
          }
        ]
      }
    ],

    "TaskCreated": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/task-created-log.sh"
          }
        ]
      }
    ],

    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/task-completed-log.sh"
          }
        ]
      }
    ],

    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/stop-quality-gate.sh"
          }
        ]
      }
    ],

    "StopFailure": [
      {
        "matcher": "rate_limit|authentication_failed",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/stop-failure-log.sh"
          }
        ]
      }
    ],

    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/teammate-idle-followup.sh"
          }
        ]
      }
    ],

    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/config-change-validate.sh"
          }
        ]
      }
    ],

    "CwdChanged": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/cwd-changed-orient.sh"
          }
        ]
      }
    ],

    "FileChanged": [
      {
        "matcher": ".env|.envrc|.claude/.forbidden-strings.txt",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/sensitive-file-changed.sh"
          }
        ]
      }
    ],

    "WorktreeCreate": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/worktree-create.sh"
          }
        ]
      }
    ],

    "WorktreeRemove": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/worktree-remove-log.sh"
          }
        ]
      }
    ],

    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/pre-compact-snapshot.sh"
          }
        ]
      }
    ],

    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/post-compact-banner.sh"
          }
        ]
      }
    ],

    "Elicitation": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/elicitation-policy.sh"
          }
        ]
      }
    ],

    "ElicitationResult": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/elicitation-result-log.sh"
          }
        ]
      }
    ],

    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/session-end-summary.sh"
          }
        ]
      }
    ]
  },

  "_alternative_hook_types": {
    "_comment": "Beyond shell command hooks, Claude Code supports four other types. Examples below; uncomment and adapt.",

    "http_hook_example": {
      "type": "http",
      "url": "https://hooks.internal.example/pre-tool-use",
      "headers": {
        "Authorization": "Bearer $MY_TOKEN"
      },
      "allowedEnvVars": ["MY_TOKEN"],
      "timeout": 30
    },

    "mcp_tool_hook_example": {
      "type": "mcp_tool",
      "server": "security-scanner",
      "tool": "scan_file",
      "input": {
        "file_path": "${tool_input.file_path}"
      }
    },

    "prompt_hook_example": {
      "type": "prompt",
      "prompt": "Is this Bash command safe? Command: $ARGUMENTS. Reply with JSON {\"ok\": true|false, \"reason\": \"...\"}.",
      "model": "claude-haiku"
    },

    "agent_hook_example": {
      "type": "agent",
      "prompt": "Security-review the change in $ARGUMENTS. Block if it introduces a SQLi or shell-injection risk."
    }
  },

  "_disable": "Set 'disableAllHooks': true at the root of settings.json to suppress all hooks (useful for debugging)."
}
