{
  "_comment": "Windsurf Cascade hooks template covering all 12 lifecycle events. Drop into <project>/.windsurf/hooks.json (workspace) or ~/.codeium/windsurf/hooks.json (user, IDE) or ~/.codeium/hooks.json (user, JetBrains). Reference: https://docs.windsurf.com/windsurf/cascade/hooks",

  "_schema_summary": {
    "blockable_events": "Only pre-hooks block: pre_user_prompt, pre_read_code, pre_write_code, pre_run_command, pre_mcp_tool_use.",
    "exit_code_protocol": {
      "0": "success; action proceeds",
      "2": "blocking error (pre-hooks only); message from stderr shown to user",
      "other": "warning; action proceeds normally"
    },
    "merge_order": "cloud (enterprise) -> system -> user -> workspace; later hooks run after earlier ones.",
    "no_declarative_matcher": "Windsurf does not have a declarative matcher field. Filter inside the script using event-specific tool_info."
  },

  "hooks": {
    "pre_user_prompt": [
      {
        "command": "bash .windsurf/hooks/scripts/prompt-policy-check.sh",
        "show_output": false
      }
    ],

    "pre_read_code": [
      {
        "command": "bash .windsurf/hooks/scripts/pre-read-redact.sh",
        "show_output": false
      }
    ],

    "post_read_code": [
      {
        "command": "bash .windsurf/hooks/scripts/post-read-log.sh",
        "show_output": false
      }
    ],

    "pre_write_code": [
      {
        "command": "bash .windsurf/hooks/scripts/pre-write-validate.sh",
        "show_output": true
      }
    ],

    "post_write_code": [
      {
        "command": "bash .windsurf/hooks/scripts/post-edit-frontmatter.sh",
        "show_output": true
      }
    ],

    "pre_run_command": [
      {
        "command": "bash .windsurf/hooks/scripts/pre-shell-sanitize.sh",
        "powershell": "powershell -File .windsurf/hooks/scripts/pre-shell-sanitize.ps1",
        "show_output": false
      }
    ],

    "post_run_command": [
      {
        "command": "bash .windsurf/hooks/scripts/post-shell-log.sh",
        "show_output": false
      }
    ],

    "pre_mcp_tool_use": [
      {
        "command": "bash .windsurf/hooks/scripts/pre-mcp-validate.sh",
        "show_output": false
      }
    ],

    "post_mcp_tool_use": [
      {
        "command": "bash .windsurf/hooks/scripts/post-mcp-log.sh",
        "show_output": false
      }
    ],

    "post_cascade_response": [
      {
        "command": "bash .windsurf/hooks/scripts/response-audit.sh",
        "show_output": false
      }
    ],

    "post_cascade_response_with_transcript": [
      {
        "command": "bash .windsurf/hooks/scripts/transcript-archive.sh",
        "show_output": false,
        "working_directory": "/var/log/windsurf-transcripts"
      }
    ],

    "post_setup_worktree": [
      {
        "command": "bash .windsurf/hooks/scripts/worktree-setup.sh",
        "show_output": true
      }
    ]
  },

  "_field_reference": {
    "command": "Required (one of command/powershell). Bash command on macOS/Linux. On Windows, used as fallback when powershell field is absent.",
    "powershell": "Required (one of command/powershell). Windows-native PowerShell command.",
    "show_output": "Optional. Default false. When true, stdout/stderr appear in the IDE.",
    "working_directory": "Optional. Defaults to workspace root."
  },

  "_event_inputs": {
    "_comment": "tool_info content varies by event:",
    "pre_read_code|post_read_code": { "file_path": "/path/to/file" },
    "pre_write_code|post_write_code": { "file_path": "...", "edits": [{"old_string": "...", "new_string": "..."}] },
    "pre_run_command|post_run_command": { "command_line": "...", "cwd": "..." },
    "pre_mcp_tool_use|post_mcp_tool_use": { "mcp_server_name": "...", "mcp_tool_name": "...", "mcp_tool_arguments": {}, "mcp_result": "(post only)" },
    "pre_user_prompt": { "user_prompt": "..." },
    "post_cascade_response": { "response": "..." },
    "post_cascade_response_with_transcript": { "transcript_path": "..." },
    "post_setup_worktree": { "worktree_path": "...", "root_workspace_path": "..." }
  },

  "_enterprise_paths": {
    "macOS_system": "/Library/Application Support/Windsurf/hooks.json",
    "Linux_system": "/etc/windsurf/hooks.json",
    "Windows_system": "C:\\ProgramData\\Windsurf\\hooks.json",
    "Cloud_dashboard": "Configure via Windsurf dashboard Team Settings (Enterprise plan)"
  }
}
