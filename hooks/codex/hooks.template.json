{
  "_comment": "Executable Codex starter. Hooks are enabled by default. The canonical feature key is hooks; codex_hooks is a deprecated alias. Only command handlers execute. Active entries reference only shipped scripts.",
  "_reference": "https://learn.chatgpt.com/docs/hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/scripts/session-start-status.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/scripts/pre-tool-sanitize.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/scripts/post-edit-frontmatter.sh"
          }
        ]
      }
    ]
  }
}
