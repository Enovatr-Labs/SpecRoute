{
  "enabled": true,
  "name": "Doc Sync Checker",
  "description": "When the README or docs change, validate that referenced files exist and that the supported vendor matrix table appears identically across README, agent-cli-integrations.md, and multi-vendor-context-files.md.",
  "version": "1",
  "when": {
    "type": "fileSaved",
    "patterns": [
      "README.md",
      "AGENTS.md",
      "docs/agent-cli-integrations.md",
      "docs/multi-vendor-context-files.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Validate doc sync: 1) Walk markdown links in the saved file; flag any that don't resolve to a tracked file. 2) Extract the supported-vendor matrix table from the saved file (rows starting with '| Vendor |' through the next blank line). 3) Compare against the tables in README.md, docs/agent-cli-integrations.md, and docs/multi-vendor-context-files.md. Report any drift as a punch list. Do not edit; just report."
  }
}
