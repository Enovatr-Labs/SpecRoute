{
  "enabled": false,
  "name": "Auto Test Runner",
  "description": "Automatically run relevant tests when code files are edited. Disabled by default to avoid slowing down development. Enable when you want continuous testing.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.py",
      "src/**/*.ts",
      "src/**/*.tsx",
      "tests/**/*.py",
      "tests/**/*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run relevant tests for the modified file. If a test runner script exists, prefer that. Otherwise, infer the test framework from the project structure (pytest for Python, jest/vitest for TS) and run scoped tests for the modified file's test target. Report pass/fail status and any coverage impact."
  }
}
